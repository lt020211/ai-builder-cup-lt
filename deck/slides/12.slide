// 12: joint F8 result and all 14 case rows.
const FONT = 'Inter, "Helvetica Neue", Arial, sans-serif';
const MONO = '"JetBrains Mono", "SF Mono", Menlo, monospace';
const INK = '#0B1220';
const BLUE = '#2F6BFF';
const RED = '#E5484D';
const DIM = '#64748B';
const BODY = '#1A2434';

const MISSES = [
    { id: 'case-xid48-dbe', why: 'hardware evidence loses to application signature votes' },
    { id: 'case-xid94-rising', why: 'frequent Xid 94 with rising ECC remains hardware_watch' },
    { id: 'case-gpu-hang-deadlock', why: 'a secondary hang taken for the root cause' },
];

<Slide style={{ width: 1280, height: 720, padding: '18px 72px', background: '#FFFFFF', fontFamily: FONT }}>
    <Box style={{ width: 1136, height: 92, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
        <Text style={{ fontSize: 34, fontWeight: 700, color: INK, lineHeight: 1.3 }}>Rule benchmark results</Text>
        <Text style={{ fontFamily: MONO, fontSize: 14, color: DIM, lineHeight: 1.45 }}>Offline baseline, no model calls</Text>
    </Box>

    <Box style={{ width: 1136, height: 544, flexDirection: 'row', gap: 24 }}>

        <Box style={{ width: 452 }}>
            <Text style={{ fontFamily: MONO, fontSize: 104, fontWeight: 700, color: INK, lineHeight: 1 }}>11 / <span style={{ color: RED }}>14</span></Text>
            <Text style={{ fontFamily: MONO, fontSize: 16, color: DIM, lineHeight: 1.5, marginTop: 8 }}>78.6% joint F8, class and RMA</Text>

            <Box style={{ width: 452, height: 1, background: '#E6EBF3', marginTop: 16, marginBottom: 14 }} />

            <Text style={{ fontSize: 16, fontWeight: 600, color: INK, lineHeight: 1.45 }}>Three rule-baseline misses</Text>
            {MISSES.map((m, i) => (
                <Box key={i} style={{ marginTop: 12, width: 452 }}>
                    <Text style={{ fontFamily: MONO, fontSize: 13, color: BLUE, lineHeight: 1.5 }}>{m.id}</Text>
                    <Text style={{ fontSize: 14, color: BODY, lineHeight: 1.5 }}>{m.why}</Text>
                </Box>
            ))}

            <Text style={{ fontSize: 13, color: DIM, lineHeight: 1.6, marginTop: 16, width: 452 }}>
                Classification alone: 11/14. RMA alone: 12/14.
                The baseline votes over signature hits and maps hardware to an RMA recommendation.
            </Text>
        </Box>

        <Box style={{ width: 660, alignItems: 'center', justifyContent: 'center' }}>
            {/* Keep all case rows inside the measured table crop. */}
            <Image src='assets/crop-bench-table.png' style={{ width: 660, height: 400, border: '1px solid #E9EDF4' }} />
            <Text style={{ fontSize: 13, color: DIM, lineHeight: 1.5, marginTop: 10, width: 660 }}>
                All 14 constructed cases, scored locally. The AI column shows Not run for this capture.
            </Text>
        </Box>

    </Box>

    <Box style={{ width: 1136, height: 48, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: DIM }}>scripts/verify_triage.mjs and the browser use the same scoring path</Text>
        <Text style={{ fontFamily: MONO, fontSize: 14, color: DIM }}>12 / 15</Text>
    </Box>
</Slide>
