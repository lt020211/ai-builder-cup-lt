// 09 · 风险不从模型来 —— 上部三行风险 + 底部全宽证据条
const FONT = 'Inter, "Helvetica Neue", Arial, sans-serif';
const MONO = '"JetBrains Mono", "SF Mono", Menlo, monospace';
const INK = '#0B1220';
const BLUE = '#2F6BFF';
const RED = '#E5484D';
const GREEN = '#16B981';
const AMBER = '#B26B00';
const PANEL = '#F1F4FA';
const DIM = '#64748B';
const BODY = '#1A2434';

const LEVELS = [
    { name: 'LOW', count: '6', color: GREEN, rule: 'Task-local, reversible, never touches hardware or the system.', gate: 'the agent may run it itself' },
    { name: 'MEDIUM', count: '5', color: AMBER, rule: 'Affects other jobs on the same node, or needs a short interruption.', gate: 'per-item approval + impact acknowledgement' },
    { name: 'HIGH', count: '3', color: RED, rule: 'Irreversible, touches hardware assets, or crosses nodes.', gate: 'approval + change ticket + second confirmation' },
];

<Slide style={{ width: 1280, height: 720, padding: '18px 72px', background: '#FFFFFF', fontFamily: FONT }}>
    <Box style={{ width: 1136, height: 92, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
        <Text style={{ fontSize: 34, fontWeight: 700, color: INK, lineHeight: 1.3 }}>The model does not set the risk level</Text>
        <Text style={{ fontFamily: MONO, fontSize: 14, color: DIM, lineHeight: 1.45 }}>14 actions · 6 low / 5 medium / 3 high</Text>
    </Box>

    <Box style={{ width: 1136, height: 544 }}>

        <Box style={{ width: 1136, height: 250, flexDirection: 'row', gap: 32 }}>

            <Box style={{ width: 700 }}>
                {LEVELS.map((l, i) => (
                    <Box key={i} style={{ width: 700, height: 62, flexDirection: 'row', alignItems: 'flex-start', gap: 16, borderTop: '1px solid #EEF2F8' }}>
                        <Text style={{ fontFamily: MONO, fontSize: 14, fontWeight: 700, color: l.color, width: 74, lineHeight: 1.9 }}>{l.name}</Text>
                        <Text style={{ fontFamily: MONO, fontSize: 22, fontWeight: 700, color: INK, width: 40, lineHeight: 1.25 }}>{l.count}</Text>
                        <Box style={{ width: 552 }}>
                            <Text style={{ fontSize: 15, color: BODY, lineHeight: 1.5 }}>{l.rule}</Text>
                            <Text style={{ fontFamily: MONO, fontSize: 13, color: DIM, lineHeight: 1.6 }}>{l.gate}</Text>
                        </Box>
                    </Box>
                ))}
                <Text style={{ fontSize: 13, color: DIM, lineHeight: 1.6, marginTop: 12, width: 700 }}>
                    A fifteenth action is registered and deliberately withheld: <span style={{ fontFamily: MONO, color: BODY }}>raise_nccl_timeout</span>.
                    Raising the timeout would suppress the symptom instead of fixing it, so the knowledge base marks it discouraged.
                </Text>
            </Box>

            <Box style={{ width: 404 }}>
                <Text style={{ fontSize: 18, fontWeight: 600, color: INK, lineHeight: 1.45 }}>The gate is a whitelist, not a prompt rule</Text>
                <Box style={{ marginTop: 8, padding: 10, borderRadius: 6, background: INK }}>
                    <Text style={{ fontFamily: MONO, fontSize: 13, color: '#E2E8F0', lineHeight: 1.7 }}>
                        if (act.risk !== 'low') {'{'}
                        <br />
                        {'  '}return {'{'} refused: true {'}'}
                        <br />
                        {'}'}
                    </Text>
                </Box>
                <Text style={{ fontSize: 14, color: BODY, lineHeight: 1.55, marginTop: 8, width: 404 }}>
                    The tool schema has no risk field, so the model has no way to call an action low-risk.
                </Text>
                <Text style={{ fontSize: 16, fontWeight: 700, color: BLUE, lineHeight: 1.5, marginTop: 8, width: 404 }}>
                    A refused action is stopped inside the tool.
                </Text>
            </Box>

        </Box>

        <Box style={{ width: 1136, height: 272, marginTop: 16, alignItems: 'center', justifyContent: 'center' }}>
            {/* 图片框 1050×272 → 1096×210。三级风险那一块在新界面里是 1152×220
                （比例 5.24）；旧框比例 3.86 比它更扁，按比例要往下补高 ——
                补出来的图会把下面「修复动作库」那条面板标题一起框进来。
                换成贴着本块比例、且略大一点的框：不留残影，字也更大。 */}
            <Image src='assets/crop-risks.png' style={{ width: 1096, height: 210, border: '1px solid #E9EDF4' }} />
        </Box>

    </Box>

    <Box style={{ width: 1136, height: 48, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: DIM }}>The three levels above are the page’s own header, captured as it renders</Text>
        <Text style={{ fontFamily: MONO, fontSize: 14, color: DIM }}>09 / 14</Text>
    </Box>
</Slide>
