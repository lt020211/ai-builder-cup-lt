// 07: cluster capture at left and seed readings at right.
const FONT = 'Inter, "Helvetica Neue", Arial, sans-serif';
const MONO = '"JetBrains Mono", "SF Mono", Menlo, monospace';
const INK = '#0B1220';
const BLUE = '#2F6BFF';
const RED = '#E5484D';
const GREEN = '#16B981';
const DIM = '#64748B';
const BODY = '#1A2434';

const READOUT = [
    { n: '6', c: INK, t: 'nodes in the constructed demo cluster' },
    { n: '4', c: RED, t: 'nodes with anomaly signals in the seed' },
    { n: '0', c: GREEN, t: 'log lines pasted for a patrol' },
];

<Slide style={{ width: 1280, height: 720, padding: '18px 72px', background: '#FFFFFF', fontFamily: FONT }}>
    <Box style={{ width: 1136, height: 92, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
        <Text style={{ fontSize: 34, fontWeight: 700, color: INK, lineHeight: 1.3 }}>Cluster inspection</Text>
        <Text style={{ fontFamily: MONO, fontSize: 14, color: DIM, lineHeight: 1.45 }}>English UI, local seed replay</Text>
    </Box>

    <Box style={{ width: 1136, height: 544, flexDirection: 'row', gap: 36 }}>

        <Box style={{ width: 659, justifyContent: 'center' }}>
            {/* Keep the supplied cluster screenshot frame and measured crop ratio. */}
            <Image src='assets/crop-cluster-card.png' style={{ width: 659, height: 422, border: '1px solid #E9EDF4' }} />
            <Text style={{ fontSize: 13, color: DIM, lineHeight: 1.5, marginTop: 14, width: 659 }}>
                The English application renders six seed nodes with four anomaly signals.
                This capture uses local Firestore response fixtures and makes no external writes.
            </Text>
        </Box>

        <Box style={{ width: 441 }}>
            <Text style={{ fontSize: 20, fontWeight: 600, color: INK, lineHeight: 1.45 }}>Initial simulated state</Text>
            <Box style={{ width: 441, height: 1, background: '#E6EBF3', marginTop: 14, marginBottom: 14 }} />

            {READOUT.map((r, i) => (
                <Box key={i} style={{ width: 441, height: 88, flexDirection: 'row', alignItems: 'center', gap: 20, borderBottom: '1px solid #EEF2F8' }}>
                    <Text style={{ fontFamily: MONO, fontSize: 42, fontWeight: 700, color: r.c, width: 62, lineHeight: 1.1 }}>{r.n}</Text>
                    <Text style={{ fontSize: 16, color: BODY, lineHeight: 1.5, width: 350 }}>{r.t}</Text>
                </Box>
            ))}

            <Text style={{ fontSize: 16, color: BODY, lineHeight: 1.6, marginTop: 20 }}>
                The deployed application reads simulated node documents from Cloud Firestore.
                A human starts each patrol. Scheduled operation would require a scheduler integration.
            </Text>
        </Box>

    </Box>

    <Box style={{ width: 1136, height: 48, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: DIM }}>Local English capture preserves the initial clean state</Text>
        <Text style={{ fontFamily: MONO, fontSize: 14, color: DIM }}>07 / 15</Text>
    </Box>
</Slide>
