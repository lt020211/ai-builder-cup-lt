// 04 · 一个错误码，两种相反的误判 —— 非对称双栏 60:40
const FONT = 'Inter, "Helvetica Neue", Arial, sans-serif';
const MONO = '"JetBrains Mono", "SF Mono", Menlo, monospace';
const INK = '#0B1220';
const BLUE = '#2F6BFF';
const RED = '#E5484D';
const PANEL = '#F1F4FA';
const DIM = '#64748B';
const BODY = '#1A2434';

const WHY = [
    'Xid 94 is a correctable ECC error. It tells you something went wrong; it does not tell you what to do.',
    'What separates the two nodes is how often the code fired in 30 days, and whether correctable ECC is rising at the same time.',
    'A lookup table maps one code to one verdict. Comparing a count against a trend needs something that can hold two numbers at once.',
];

<Slide style={{ width: 1280, height: 720, padding: '18px 72px', background: '#FFFFFF', fontFamily: FONT }}>
    <Box style={{ width: 1136, height: 92, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
        <Text style={{ fontSize: 34, fontWeight: 700, color: INK, lineHeight: 1.3 }}>One code, two opposite mistakes</Text>
        <Text style={{ fontFamily: MONO, fontSize: 14, color: DIM, lineHeight: 1.45 }}>Xid taxonomy · 24 codes</Text>
    </Box>

    <Box style={{ width: 1136, height: 544, flexDirection: 'row', gap: 36, alignItems: 'center' }}>

        <Box style={{ width: 660 }}>
            <Text style={{ fontSize: 13, color: DIM, textAlign: 'center', width: 660, lineHeight: 1.5 }}>the operator sees exactly this</Text>

            <Box style={{ width: 660, alignItems: 'center', marginTop: 8 }}>
                <Box style={{ paddingTop: 8, paddingBottom: 8, paddingLeft: 18, paddingRight: 18, borderRadius: 6, background: INK }}>
                    <Text style={{ fontFamily: MONO, fontSize: 22, fontWeight: 600, color: '#FFFFFF' }}>Xid 94</Text>
                </Box>
            </Box>

            <svg width={660} height={78} viewBox='0 0 660 78'>
                <line x1={330} y1={2} x2={330} y2={36} stroke='#B6C2D4' strokeWidth={2} />
                <line x1={170} y1={36} x2={510} y2={36} stroke='#B6C2D4' strokeWidth={2} />
                <line x1={170} y1={36} x2={170} y2={66} stroke='#B6C2D4' strokeWidth={2} />
                <line x1={510} y1={36} x2={510} y2={66} stroke='#B6C2D4' strokeWidth={2} />
                <path d='M164 62 L170 76 L176 62 Z' fill='#B6C2D4' />
                <path d='M504 62 L510 76 L516 62 Z' fill='#B6C2D4' />
            </svg>

            <Box style={{ width: 660, flexDirection: 'row', gap: 20 }}>
                <Box style={{ width: 340, padding: 18, borderRadius: 8, background: '#FDF3F3', borderLeft: '4px solid ' + RED }}>
                    <Text style={{ fontSize: 19, fontWeight: 600, color: INK, lineHeight: 1.4 }}>Read as hardware</Text>
                    <Text style={{ fontFamily: MONO, fontSize: 14, color: BODY, lineHeight: 1.6, marginTop: 8 }}>cordon · file the RMA</Text>
                    <Box style={{ width: 300, height: 1, background: '#E9C4C6', marginTop: 12, marginBottom: 12 }} />
                    <Text style={{ fontSize: 15, color: DIM, lineHeight: 1.55 }}>Cost:</Text>
                    <Text style={{ fontSize: 16, color: RED, lineHeight: 1.55, fontWeight: 600 }}>a healthy card is offline for weeks, and the capacity is gone with it.</Text>
                </Box>
                <Box style={{ width: 300, padding: 18, borderRadius: 8, background: PANEL, borderLeft: '4px solid ' + BLUE }}>
                    <Text style={{ fontSize: 19, fontWeight: 600, color: INK, lineHeight: 1.4 }}>Read as software</Text>
                    <Text style={{ fontFamily: MONO, fontSize: 14, color: BODY, lineHeight: 1.6, marginTop: 8 }}>retry · move on</Text>
                    <Box style={{ width: 260, height: 1, background: '#CBD8EC', marginTop: 12, marginBottom: 12 }} />
                    <Text style={{ fontSize: 15, color: DIM, lineHeight: 1.55 }}>Cost:</Text>
                    <Text style={{ fontSize: 16, color: BLUE, lineHeight: 1.55, fontWeight: 600 }}>you keep training on a degrading card until the error turns uncorrectable (Xid 95).</Text>
                </Box>
            </Box>
        </Box>

        <Box style={{ width: 440, gap: 16 }}>
            <Text style={{ fontSize: 20, fontWeight: 600, color: INK, lineHeight: 1.45 }}>Why the code cannot be the rule</Text>
            {WHY.map((t, i) => (
                <Box key={i} style={{ flexDirection: 'row', gap: 12 }}>
                    <Box style={{ width: 6, height: 6, borderRadius: 3, background: BLUE, marginTop: 10 }} />
                    <Text style={{ fontSize: 16, color: BODY, lineHeight: 1.62, width: 418 }}>{t}</Text>
                </Box>
            ))}
            <Box style={{ width: 440, height: 1, background: '#E6EBF3', marginTop: 6, marginBottom: 6 }} />
            <Text style={{ fontSize: 20, fontWeight: 700, color: INK, lineHeight: 1.45 }}>The code alone cannot choose between them. The 30-day trend can.</Text>
        </Box>

    </Box>

    <Box style={{ width: 1136, height: 48, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: DIM }}>Training Failure Triage · AI Builder Cup 2026</Text>
        <Text style={{ fontFamily: MONO, fontSize: 14, color: DIM }}>04 / 14</Text>
    </Box>
</Slide>
