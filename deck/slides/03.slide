// 03 · 章节扉页 01 —— 深底 + 网格 + 巨型「94」
const FONT = 'Inter, "Helvetica Neue", Arial, sans-serif';
const MONO = '"JetBrains Mono", "SF Mono", Menlo, monospace';
const BLUE = '#2F6BFF';
const DEEP = 'linear-gradient(160deg, #0B1220 0%, #131E33 62%, #0B1220 100%)';

const GRID_X = [0, 71, 142, 213, 284, 355, 426, 497, 568, 639, 710, 781, 852, 923, 994, 1065, 1136];
const GRID_Y = [0, 64, 128, 192, 256, 320, 384, 448, 512, 576];

<Slide style={{ width: 1280, height: 720, padding: '72px', background: DEEP, fontFamily: FONT }}>
    <Box style={{ position: 'relative', width: 1136, height: 576 }}>

        <Box style={{ position: 'absolute', left: 0, top: 0, width: 1136, height: 576 }}>
            <svg width={1136} height={576} viewBox='0 0 1136 576'>
                {GRID_X.map((x, i) => (
                    <line key={'gx' + i} x1={x} y1={0} x2={x} y2={576} stroke='rgba(255,255,255,0.045)' strokeWidth={1} />
                ))}
                {GRID_Y.map((y, i) => (
                    <line key={'gy' + i} x1={0} y1={y} x2={1136} y2={y} stroke='rgba(255,255,255,0.045)' strokeWidth={1} />
                ))}
            </svg>
        </Box>

        <Box style={{ position: 'absolute', right: 0, top: 118, width: 620, alignItems: 'flex-end' }}>
            <Text style={{ fontFamily: MONO, fontSize: 300, fontWeight: 700, color: 'rgba(229,72,77,0.15)', lineHeight: 1 }}>94</Text>
        </Box>

        <Box style={{ position: 'relative', width: 820, height: 576, justifyContent: 'center', gap: 18 }}>
            <Text style={{ fontFamily: MONO, fontSize: 14, color: BLUE, letterSpacing: 3 }}>CHAPTER 01</Text>
            <Text style={{ fontSize: 64, fontWeight: 700, color: '#FFFFFF', lineHeight: 1.1 }}>The problem</Text>
            <Text style={{ fontSize: 24, color: '#94A3B8', lineHeight: 1.5 }}>The same error code, two opposite mistakes</Text>
            <Box style={{ width: 88, height: 3, background: 'rgba(255,255,255,0.28)', marginTop: 14 }} />
            <Text style={{ fontSize: 18, color: '#C7D2E0', lineHeight: 1.65, width: 760 }}>
                Calling a dying card healthy burns weeks of compute on it. Calling a healthy card dying pulls a
                working GPU out of the pool. Both are expensive, and telling the two apart is the whole problem.
            </Text>
        </Box>

        <Box style={{ position: 'absolute', left: 0, bottom: 0, width: 1136, flexDirection: 'row', justifyContent: 'flex-end' }}>
            <Text style={{ fontFamily: MONO, fontSize: 14, color: 'rgba(255,255,255,0.45)' }}>03 / 14</Text>
        </Box>

    </Box>
</Slide>
