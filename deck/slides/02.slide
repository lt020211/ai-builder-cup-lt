// 02: overview with three chapter rows.
const FONT = 'Inter, "Helvetica Neue", Arial, sans-serif';
const MONO = '"JetBrains Mono", "SF Mono", Menlo, monospace';
const INK = '#0B1220';
const BLUE = '#2F6BFF';
const DIM = '#64748B';

const CHAPTERS = [
    { no: '01', title: 'The problem', desc: 'Hardware escalation depends on error frequency and ECC trends', range: '03 - 05' },
    { no: '02', title: 'Application workflow', desc: 'Cluster inspection and action approval with state verification', range: '06 - 10' },
    { no: '03', title: 'Evidence and limits', desc: 'Rule baseline of 11/14 and the unsupported artifact tier', range: '11 - 15' },
];

<Slide style={{ width: 1280, height: 720, padding: '18px 72px', background: '#FFFFFF', fontFamily: FONT }}>
    <Box style={{ width: 1136, height: 92, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
        <Text style={{ fontSize: 34, fontWeight: 700, color: INK, lineHeight: 1.3 }}>Submission overview</Text>
        <Text style={{ fontFamily: MONO, fontSize: 14, color: DIM, lineHeight: 1.45 }}>Roadmap</Text>
    </Box>

    <Box style={{ width: 1136, height: 544, flexDirection: 'row', gap: 40 }}>
        <Box style={{ width: 340, justifyContent: 'flex-start', gap: 18 }}>
            <Box style={{ width: 3, height: 62, background: BLUE }} />
            <Text style={{ fontSize: 22, fontWeight: 600, color: INK, lineHeight: 1.5 }}>
                Training failure diagnosis and controlled actions
            </Text>
            <Text style={{ fontSize: 16, color: DIM, lineHeight: 1.6 }}>
                The deck covers the Xid 94 contrast, the browser application, and a reproducible rule benchmark.
                Historical patrol measurements describe individual runs.
            </Text>
            <Text style={{ fontFamily: MONO, fontSize: 14, color: DIM, lineHeight: 1.6, marginTop: 6 }}>
                Six simulated nodes. Human approval for medium and high risk actions.
            </Text>
        </Box>

        <Box style={{ width: 756 }}>
            {CHAPTERS.map((c, i) => (
                <Box key={i} style={{
                    width: 756, height: 180, flexDirection: 'row', alignItems: 'center', gap: 24,
                    borderBottom: i < 2 ? '1px solid #E6EBF3' : 'none',
                }}>
                    <Text style={{ fontFamily: MONO, fontSize: 40, fontWeight: 700, color: BLUE, width: 74 }}>{c.no}</Text>
                    <Box style={{ flex: 1 }}>
                        <Text style={{ fontSize: 26, fontWeight: 600, color: INK, lineHeight: 1.4 }}>{c.title}</Text>
                        <Text style={{ fontSize: 15, color: DIM, lineHeight: 1.55, marginTop: 4 }}>{c.desc}</Text>
                    </Box>
                    <Text style={{ fontFamily: MONO, fontSize: 14, color: DIM }}>{c.range}</Text>
                </Box>
            ))}
        </Box>
    </Box>

    <Box style={{ width: 1136, height: 48, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: DIM }}>Training Failure Triage, AI Builder Cup 2026</Text>
        <Text style={{ fontFamily: MONO, fontSize: 14, color: DIM }}>02 / 15</Text>
    </Box>
</Slide>
