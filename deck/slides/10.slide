// 10: triage replay summary and actual application tool trace.
const FONT = 'Inter, "Helvetica Neue", Arial, sans-serif';
const MONO = '"JetBrains Mono", "SF Mono", Menlo, monospace';
const INK = '#0B1220';
const BLUE = '#2F6BFF';
const RED = '#E5484D';
const DIM = '#64748B';
const BODY = '#1A2434';

<Slide style={{ width: 1280, height: 720, padding: '18px 72px', background: '#FFFFFF', fontFamily: FONT }}>
    <Box style={{ width: 1136, height: 92, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
        <Text style={{ fontSize: 34, fontWeight: 700, color: INK, lineHeight: 1.3 }}>Triage tool trace</Text>
        <Text style={{ fontFamily: MONO, fontSize: 14, color: DIM, lineHeight: 1.45 }}>case-xid94-rising, local replay</Text>
    </Box>

    <Box style={{ width: 1136, height: 544 }}>

        <Box style={{ width: 1136, height: 104, flexDirection: 'row', alignItems: 'center', gap: 24 }}>
            <Box style={{ paddingTop: 8, paddingBottom: 8, paddingLeft: 16, paddingRight: 16, borderRadius: 6, background: INK }}>
                <Text style={{ fontFamily: MONO, fontSize: 18, fontWeight: 600, color: '#FFFFFF' }}>hardware</Text>
            </Box>
            <Box style={{ paddingTop: 8, paddingBottom: 8, paddingLeft: 16, paddingRight: 16, borderRadius: 6, background: RED }}>
                <Text style={{ fontFamily: MONO, fontSize: 18, fontWeight: 600, color: '#FFFFFF' }}>RMA advised</Text>
            </Box>
            <Text style={{ fontFamily: MONO, fontSize: 72, fontWeight: 700, color: INK, lineHeight: 1 }}>0.95</Text>
            <Box>
                <Text style={{ fontSize: 15, color: DIM, lineHeight: 1.4 }}>confidence in replay fixture</Text>
                <Text style={{ fontSize: 15, color: DIM, lineHeight: 1.4 }}>4 recorded tool calls</Text>
            </Box>
            <Box style={{ flex: 1 }} />
            <Text style={{ fontFamily: MONO, fontSize: 14, color: DIM, lineHeight: 1.5 }}>expected: hardware, RMA</Text>
        </Box>

        <Box style={{ width: 1136, height: 240 }}>
            <Text style={{ fontFamily: MONO, fontSize: 13, color: DIM, lineHeight: 1.6 }}>
                English replay fixture rendered by the application tool-trace component
            </Text>
            <Image src='assets/crop-tooltrace.png' style={{ width: 1096, height: 204, marginTop: 8, border: '1px solid #E9EDF4' }} />
        </Box>

        <Box style={{ width: 1136, height: 168, flexDirection: 'row', gap: 36, marginTop: 32 }}>

            <Box style={{ width: 700 }}>
                <Text style={{ fontSize: 20, fontWeight: 600, color: INK, lineHeight: 1.45 }}>Tool evidence for the recommendation</Text>
                <Text style={{ fontSize: 15, color: BODY, lineHeight: 1.62, marginTop: 10, width: 700 }}>
                    <span style={{ fontFamily: MONO, color: INK }}>lookup_xid</span> reads the Xid knowledge base.
                    <span style={{ fontFamily: MONO, color: INK }}> inspect_node</span> supplies node telemetry.
                    The prompt requires tool evidence for numerical claims.
                </Text>
            </Box>

            <Box style={{ width: 400 }}>
                <Text style={{ fontFamily: MONO, fontSize: 13, color: BLUE, lineHeight: 1.6 }}>References T1, T2 and T3</Text>
                <Text style={{ fontSize: 15, color: BODY, lineHeight: 1.62, marginTop: 8, width: 400 }}>
                    The app registers references when tools execute. It drops unknown reference IDs from proposed actions and reports the dropped IDs.
                </Text>
            </Box>

        </Box>

    </Box>

    <Box style={{ width: 1136, height: 48, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: DIM }}>Local replay demonstrates English rendering and makes no model request</Text>
        <Text style={{ fontFamily: MONO, fontSize: 14, color: DIM }}>10 / 15</Text>
    </Box>
</Slide>
