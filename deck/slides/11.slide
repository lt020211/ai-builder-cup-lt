        </Box>

        <Box style={{ position: 'relative', width: 760, height: 576, justifyContent: 'center', gap: 18 }}>
            <Text style={{ fontFamily: MONO, fontSize: 14, color: BLUE, letterSpacing: 3 }}>CHAPTER 03</Text>
            <Text style={{ fontSize: 64, fontWeight: 700, color: '#FFFFFF', lineHeight: 1.1 }}>Evidence &amp; boundaries</Text>
            <Text style={{ fontSize: 24, color: '#94A3B8', lineHeight: 1.5 }}>Reproducible numbers, stated limits</Text>
            <Box style={{ width: 88, height: 3, background: 'rgba(255,255,255,0.28)', marginTop: 14 }} />
