// 05: large event counts and separate node-row evidence.
const FONT = 'Inter, "Helvetica Neue", Arial, sans-serif';
const MONO = '"JetBrains Mono", "SF Mono", Menlo, monospace';
const INK = '#0B1220';
const RED = '#E5484D';
const GREEN = '#16B981';
const DIM = '#64748B';
const BODY = '#1A2434';

const PAIR = [
    {
        big: '1', node: 'lyg2103', tint: 'rgba(22,185,129,0.07)', bar: GREEN, color: GREEN,
        l1: 'Xid 94 in the last 30 days', l2: 'Correctable ECC 1, flat trend', chip: 'hardware_watch, no RMA',
    },
    {
        big: '53', node: 'lyg2112', tint: 'rgba(229,72,77,0.07)', bar: RED, color: RED,
        l1: 'Xid 94 in the last 30 days', l2: 'Correctable ECC 118, rising trend', chip: 'hardware, RMA recommended',
    },
];

<Slide style={{ width: 1280, height: 720, padding: '18px 72px', background: '#FFFFFF', fontFamily: FONT }}>
    <Box style={{ width: 1136, height: 92, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
        <Text style={{ fontSize: 34, fontWeight: 700, color: INK, lineHeight: 1.3 }}>Xid 94 frequency and ECC trends</Text>
        <Text style={{ fontFamily: MONO, fontSize: 14, color: DIM, lineHeight: 1.45 }}>lyg2103 vs lyg2112, 30-day window</Text>
    </Box>

    <Box style={{ width: 1136, height: 544 }}>

        <Box style={{ width: 1136, height: 175, flexDirection: 'row', gap: 24 }}>
            <Box style={{ width: 489, padding: 16, borderRadius: 8, background: PAIR[0].tint, borderLeft: '4px solid ' + PAIR[0].bar, flexDirection: 'row', alignItems: 'center', gap: 18 }}>
                <Text style={{ fontFamily: MONO, fontSize: 104, fontWeight: 700, color: PAIR[0].color, lineHeight: 1 }}>{PAIR[0].big}</Text>
                <Box style={{ gap: 4 }}>
                    <Text style={{ fontFamily: MONO, fontSize: 18, fontWeight: 700, color: INK, lineHeight: 1.4 }}>{PAIR[0].node}</Text>
                    <Text style={{ fontSize: 14, color: DIM, lineHeight: 1.5 }}>{PAIR[0].l1}</Text>
                    <Text style={{ fontSize: 14, color: DIM, lineHeight: 1.5 }}>{PAIR[0].l2}</Text>
                    <Box style={{ marginTop: 6, paddingTop: 4, paddingBottom: 4, paddingLeft: 10, paddingRight: 10, borderRadius: 4, background: PAIR[0].bar }}>
                        <Text style={{ fontFamily: MONO, fontSize: 13, color: '#FFFFFF' }}>{PAIR[0].chip}</Text>
                    </Box>
                </Box>
            </Box>

            <Box style={{ width: 623, padding: 16, borderRadius: 8, background: PAIR[1].tint, borderLeft: '4px solid ' + PAIR[1].bar, flexDirection: 'row', alignItems: 'center', gap: 18 }}>
                <Text style={{ fontFamily: MONO, fontSize: 104, fontWeight: 700, color: PAIR[1].color, lineHeight: 1 }}>{PAIR[1].big}</Text>
                <Box style={{ gap: 4 }}>
                    <Text style={{ fontFamily: MONO, fontSize: 18, fontWeight: 700, color: INK, lineHeight: 1.4 }}>{PAIR[1].node}</Text>
                    <Text style={{ fontSize: 14, color: DIM, lineHeight: 1.5 }}>{PAIR[1].l1}</Text>
                    <Text style={{ fontSize: 14, color: DIM, lineHeight: 1.5 }}>{PAIR[1].l2}</Text>
                    <Box style={{ marginTop: 6, paddingTop: 4, paddingBottom: 4, paddingLeft: 10, paddingRight: 10, borderRadius: 4, background: PAIR[1].bar }}>
                        <Text style={{ fontFamily: MONO, fontSize: 13, color: '#FFFFFF' }}>{PAIR[1].chip}</Text>
                    </Box>
                </Box>
            </Box>
        </Box>

        {/* Separate crops retain the source rows and identify the omitted intervening rows. */}
        <Box style={{ width: 1136, height: 291, marginTop: 16, alignItems: 'center' }}>
            <Image src='assets/crop-node-lyg2103.png' style={{ width: 1120, height: 116, border: '1px solid #E9EDF4' }} />
            <Box style={{ width: 1120, height: 15, justifyContent: 'center' }}>
                <Text style={{ fontSize: 11, color: DIM, lineHeight: 1.3 }}>
                    The source list has two intervening rows, lyg2107 and lyg2108, omitted here
                </Text>
            </Box>
            <Image src='assets/crop-node-lyg2112.png' style={{ width: 1120, height: 158, border: '1px solid #E9EDF4' }} />
        </Box>

        <Box style={{ width: 1136, height: 46, marginTop: 16, justifyContent: 'center' }}>
            <Text style={{ fontSize: 20, fontWeight: 600, color: BODY, lineHeight: 1.45 }}>
                Both nodes report Xid 94. <span style={{ color: INK }}>lyg2112 has more frequent events and rising correctable ECC</span>.
            </Text>
        </Box>

    </Box>

    <Box style={{ width: 1136, height: 48, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: DIM }}>English UI capture from the local seed replay, using the same 30-day window</Text>
        <Text style={{ fontFamily: MONO, fontSize: 14, color: DIM }}>05 / 15</Text>
    </Box>
</Slide>
