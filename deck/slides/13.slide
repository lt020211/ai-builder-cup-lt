// 13: five architecture layers and code responsibilities.
const FONT = 'Inter, "Helvetica Neue", Arial, sans-serif';
const MONO = '"JetBrains Mono", "SF Mono", Menlo, monospace';
const INK = '#0B1220';
const BLUE = '#2F6BFF';
const PANEL = '#F1F4FA';
const DIM = '#64748B';
const BODY = '#1A2434';

const LAYERS = [
    { no: '01', t: 'Knowledge base', d: '24 Xid entries, 27 failure signatures and 6 diagnostic principles' },
    { no: '02', t: 'Deterministic pre-analysis', d: 'Local compatibility checks and memory accounting produce structured facts' },
    { no: '03', t: 'Tools', d: '10 registered tools, with 6 available for cases and all 10 for patrol' },
    { no: '04', t: 'Model loop', d: 'Gemini allows up to 12 turns per attempt. Fallback retains completed calls.' },
    { no: '05', t: 'Execution', d: 'Automatic actions require low risk. The app checks state and records the result.' },
];

<Slide style={{ width: 1280, height: 720, padding: '18px 72px', background: '#FFFFFF', fontFamily: FONT }}>
    <Box style={{ width: 1136, height: 92, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
        <Text style={{ fontSize: 34, fontWeight: 700, color: INK, lineHeight: 1.3 }}>Application architecture</Text>
        <Text style={{ fontFamily: MONO, fontSize: 14, color: DIM, lineHeight: 1.45 }}>Architecture</Text>
    </Box>

    <Box style={{ width: 1136, height: 544, flexDirection: 'row', gap: 36 }}>

        <Box style={{ width: 704 }}>
            {LAYERS.map((l, i) => (
                <Box key={i} style={{
                    width: 704, height: 96, marginBottom: i < 4 ? 10 : 0, paddingLeft: 16, paddingRight: 16,
                    background: i === 3 ? 'rgba(47,107,255,0.07)' : PANEL, borderRadius: 6,
                    borderLeft: '4px solid ' + (i === 3 ? BLUE : '#C3CFE2'),
                    flexDirection: 'row', alignItems: 'center', gap: 18,
                }}>
                    <Text style={{ fontFamily: MONO, fontSize: 14, fontWeight: 700, color: i === 3 ? BLUE : DIM, width: 30 }}>{l.no}</Text>
                    <Box style={{ width: 620 }}>
                        <Text style={{ fontSize: 19, fontWeight: 600, color: INK, lineHeight: 1.35 }}>{l.t}</Text>
                        <Text style={{ fontSize: 14, color: DIM, lineHeight: 1.5, marginTop: 3 }}>{l.d}</Text>
                    </Box>
                </Box>
            ))}
        </Box>

        <Box style={{ width: 396 }}>
            <Text style={{ fontSize: 22, fontWeight: 600, color: INK, lineHeight: 1.45 }}>Prompt and code responsibilities</Text>
            <Text style={{ fontSize: 16, color: BODY, lineHeight: 1.65, marginTop: 14, width: 396 }}>
                The prompt requires tool evidence for numerical claims. The action library supplies risk levels
                for the action IDs the model selects.
            </Text>
            <Text style={{ fontSize: 16, color: BODY, lineHeight: 1.65, marginTop: 14, width: 396 }}>
                Code limits available tools and rejects automatic execution above low risk.
                Citation checks remove unknown references from proposed actions.
            </Text>
            <Box style={{ width: 396, height: 1, background: '#E6EBF3', marginTop: 22, marginBottom: 22 }} />
            <Text style={{ fontSize: 19, fontWeight: 700, color: INK, lineHeight: 1.5, width: 396 }}>
                Medium and high risk actions require operator approval
            </Text>
        </Box>

    </Box>

    <Box style={{ width: 1136, height: 48, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: DIM }}>The app selects each mode's tool list before the model loop starts</Text>
        <Text style={{ fontFamily: MONO, fontSize: 14, color: DIM }}>13 / 15</Text>
    </Box>
</Slide>
