// 01: cover, preserving the supplied dark grid and large score.
const FONT = 'Inter, "Helvetica Neue", Arial, sans-serif';
const MONO = '"JetBrains Mono", "SF Mono", Menlo, monospace';
const BLUE = '#2F6BFF';
const DEEP = 'linear-gradient(160deg, #0B1220 0%, #131E33 62%, #0B1220 100%)';

const GRID_X = [0, 71, 142, 213, 284, 355, 426, 497, 568, 639, 710, 781, 852, 923, 994, 1065, 1136];
const GRID_Y = [0, 64, 128, 192, 256, 320, 384, 448, 512, 576];

const STEPS = ['Detection', 'Evidence collection', 'Diagnosis and plan', 'Action and verification'];

<Slide style={{ width: 1280, height: 720, padding: '72px', background: DEEP, fontFamily: FONT }}>
    <Box style={{ position: 'relative', width: 1136, height: 576 }}>

        <Box style={{ position: 'absolute', left: 0, top: 0, width: 1136, height: 576 }}>
            <svg width={1136} height={576} viewBox='0 0 1136 576'>
                {GRID_X.map((x, i) => (
                    <line key={'gx' + i} x1={x} y1={0} x2={x} y2={576} stroke='rgba(255,255,255,0.05)' strokeWidth={1} />
                ))}
                {GRID_Y.map((y, i) => (
                    <line key={'gy' + i} x1={0} y1={y} x2={1136} y2={y} stroke='rgba(255,255,255,0.05)' strokeWidth={1} />
                ))}
            </svg>
        </Box>

        <Box style={{ position: 'absolute', right: 0, top: 74, width: 660, alignItems: 'flex-end' }}>
            <Text style={{ fontFamily: MONO, fontSize: 176, fontWeight: 700, color: 'rgba(47,107,255,0.17)', lineHeight: 1.02 }}>11 /</Text>
            <Text style={{ fontFamily: MONO, fontSize: 176, fontWeight: 700, color: 'rgba(47,107,255,0.17)', lineHeight: 1.02 }}>14</Text>
        </Box>

        <Box style={{ position: 'relative', width: 790, height: 576, justifyContent: 'center', gap: 22 }}>
            <Text style={{ fontFamily: MONO, fontSize: 14, color: BLUE, letterSpacing: 3 }}>AI BUILDER CUP 2026, JAPAC</Text>
            <Text style={{ fontSize: 76, fontWeight: 700, color: '#FFFFFF', lineHeight: 1.08 }}>Training Failure</Text>
            <Text style={{ fontSize: 76, fontWeight: 700, color: '#FFFFFF', lineHeight: 1.08 }}>Triage</Text>
            <Box style={{ width: 96, height: 3, background: BLUE, marginTop: 10 }} />
            <Text style={{ fontSize: 20, color: '#94A3B8', lineHeight: 1.62, width: 720 }}>
                Evidence for deciding <span style={{ color: '#E2E8F0' }}>whether a training failure comes from software or GPU hardware</span>, with risk controls for the proposed action.
            </Text>
            <Box style={{ flexDirection: 'row', gap: 10, marginTop: 12 }}>
                {STEPS.map((s, i) => (
                    <Box key={i} style={{ paddingTop: 7, paddingBottom: 7, paddingLeft: 13, paddingRight: 13, borderRadius: 5, background: 'rgba(255,255,255,0.07)', border: '1px solid rgba(255,255,255,0.13)' }}>
                        <Text style={{ fontSize: 14, color: '#C7D2E0' }}>{s}</Text>
                    </Box>
                ))}
            </Box>
            <Text style={{ fontFamily: MONO, fontSize: 13, color: 'rgba(255,255,255,0.42)', lineHeight: 1.5, width: 720 }}>
                11 / 14 is the joint classification and RMA rule score on 14 constructed cases
            </Text>
        </Box>

        <Box style={{ position: 'absolute', left: 0, bottom: 0, width: 1136, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
            <Text style={{ fontFamily: MONO, fontSize: 14, color: 'rgba(255,255,255,0.52)' }}>gpu-waste-auditor-2026.web.app</Text>
            <Text style={{ fontSize: 14, color: 'rgba(255,255,255,0.52)' }}>Sustainability &amp; Social Impact</Text>
        </Box>

    </Box>
</Slide>
